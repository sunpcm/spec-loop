{
  "name": "spec-loop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "GitHub + Pi Coding Agent 本地文档驱动开发演示",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5174",
    "typecheck": "tsc --noEmit",
    "test": "node --test 'tests/*.test.ts'",
    "build": "vite build --configLoader native",
    "demo:init": "node orchestrator/init.ts",
    "demo": "node orchestrator/index.ts",
    "demo:status": "node orchestrator/status.ts",
    "demo:retry": "node orchestrator/retry.ts",
    "demo:recover": "node orchestrator/recover.ts",
    "build:panel": "vite build --config panel/vite.config.ts --configLoader native",
    "panel": "npm run build:panel && node orchestrator/panel.ts",
    "test:e2e": "node orchestrator/browser-gate-cli.ts counter",
    "test:e2e:panel": "node orchestrator/browser-gate-cli.ts panel"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "1.5.2",
    "@larksuiteoapi/node-sdk": "1.76.0",
    "@xyflow/react": "12.12.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "^5.8.0",
    "@playwright/test": "1.65.1",
    "vite": "^6.0.0"
  }
}

# 复制为 .env.local 后填写；.env.local 是本地私有文件，不要提交或粘贴到聊天。
# orchestrator/feishu.ts 不读取环境变量；以下变量由核心节点解析为 FeishuSettings。

# 可选覆盖；只填写需要覆盖的项，未使用项请删除整行（空白值不应作为配置）。
SPEC_LOOP_REPO=
SPEC_LOOP_MAIN_BRANCH=
SPEC_LOOP_HTTP_PORT=
SPEC_LOOP_PREVIEW_PORT=
SPEC_LOOP_DEV_PORT=

# Pi 官方 registry 包 @earendil-works/pi-coding-agent 固定为 1.5.2。
PI_PROVIDER=
PI_MODEL=
# 私有 agent 目录；建议填写绝对路径，例如 .orchestrator/agent 的绝对路径。
PI_CODING_AGENT_DIR=
# 只写入本地 .env.local；models.json 使用 ${SPEC_LOOP_PI_API_KEY} 引用。
SPEC_LOOP_PI_API_KEY=

# true 时启用飞书长连接；缺少任一必需项时核心节点应明确报缺项
FEISHU_ENABLED=false

# 飞书开放平台自建应用的 App ID / App Secret
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# 接收通知并允许执行命令的唯一绑定会话（单聊或群聊）chat_id，通常以 oc_ 开头
FEISHU_CHAT_ID=

# 允许发命令的用户 open_id 白名单，逗号分隔；留空表示拒绝所有命令（通知不受影响）
FEISHU_ALLOWED_USER_IDS=
